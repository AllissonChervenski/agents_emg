# ==============================================================================
# semg_classification — Environment Configuration Example (.env.example)
# ==============================================================================
#
# SECURITY GOVERNANCE:
# - NEVER commit sensitive credentials, passwords, or private API keys to git.
# - Production code MUST read any sensitive parameters strictly from environment
#   variables or a local, uncommitted .env file.
# - Copy this file to .env: `cp .env.example .env` and adjust variables locally.
# ==============================================================================

# Data Paths
SEMG_DATA_ROOT=./data
SEMG_RAW_DIR=./data/raw
SEMG_DERIVED_DIR=./data/derived

# Logging & Environment
SEMG_LOG_LEVEL=INFO
SEMG_DETERMINISTIC_SEED=42

# Optional Remote Service Integrations (Leave empty if running fully local)
# WANDB_API_KEY=
# HUGGINGFACE_TOKEN=
